# Copy to `.env` and adjust for your machine. Never commit `.env`.

# --- Database (used by docker-compose.yml) ---
POSTGRES_USER=brewpass
POSTGRES_PASSWORD=brewpass
POSTGRES_DB=brewpass
POSTGRES_PORT=5432

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://brewpass:brewpass@localhost:5432/brewpass
CORS_ORIGINS=["http://localhost:5173"]
