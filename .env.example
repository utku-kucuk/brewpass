# Copy to `.env` and adjust for your machine. Never commit `.env`.
# docker compose reads these values and passes them to the services (see docker-compose.yml).

# --- Database ---
POSTGRES_USER=brewpass
POSTGRES_PASSWORD=brewpass
POSTGRES_DB=brewpass
POSTGRES_PORT=5432

# --- Gateway ---
GATEWAY_PORT=8080

# --- All services ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# json (structured, default) or text (human-readable)
LOG_FORMAT=json
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
# Shared secret for service-to-service calls on /internal routes.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=replace-with-a-long-random-internal-token
# Load demo accounts, shops and plans when a service starts (idempotent).
SEED_ON_START=true

# --- Auth service ---
# The RS256 key pair lives in ./secrets (created by scripts/generate-dev-keys.sh).
# Secret used to hash OTP codes and refresh tokens at rest.
HASH_SECRET=replace-with-a-long-random-hash-secret
# Fixed one-time password for non-production environments
OTP_MOCK_CODE=1234

# --- Commerce service ---
# Secret used to sign pickup QR codes (HMAC-SHA256).
QR_SIGNING_SECRET=replace-with-a-long-random-qr-secret
# Refuse orders while a shop is closed. Set to false for late-night demos.
ENFORCE_OPENING_HOURS=true
